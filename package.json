{
  "name": "@mf-realworld/root",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "git@github.com:Sm1t/microfrontend-realworld-app.git",
  "author": "Viacheslav Konyshev",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*",
    "shared/*"
  ],
  "scripts": {
    "dev": "yarn workspaces foreach --since -pt run dev",
    "dev:all": "yarn workspaces foreach -A -pi --exclude . run dev",
    "build": "yarn workspaces foreach --since -pt run build",
    "build:all": "yarn workspaces foreach -A -pi --exclude . run build",
    "preview": "yarn workspaces foreach --since -pt run preview",
    "preview:all": "yarn workspaces foreach -A -pi --exclude . run preview",
    "test": "yarn workspaces foreach --since -p run test"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.16",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@module-federation/rsbuild-plugin": "^2.4.0",
    "@rsbuild/core": "^1.6.4",
    "@rsbuild/plugin-react": "^1.4.2",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "packageManager": "yarn@4.12.0"
}
