{
  "compilerOptions": {
    "lib": ["esnext"],
    "target": "es2017",
    "module": "NodeNext",
    "skipLibCheck": true,
    "outDir": "./build",
    "rootDir": "./src",
    "declaration": true,
    "moduleResolution": "nodenext",
    "types": ["node"],
    "allowJs": true
  },
  "include": ["src/**/*.ts", "src/html-template.js"]
}
